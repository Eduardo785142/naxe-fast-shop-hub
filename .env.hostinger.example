# Enter these values securely in hPanel. Do not upload a real environment file.
APP_ORIGIN=https://darkslateblue-pelican-597772.hostingersite.com
DEMO_MODE=true
STREAMING_PROVIDER=demo
# Real connection URLs to persistent services reachable FROM the hosting:
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379
# Enable only for the first startup if demo accounts/catalog are wanted.
ENABLE_DEMO_SEED=true
# Set a new private password, not the local README password.
DEMO_PASSWORD=
# Keep API_INTERNAL_URL unset for co-located frontend/API (loopback port 4000).
# Do not copy PORT=4000 from the local example. Hosting supplies its public PORT.
